# Copy to .env and fill in every value. Then: docker compose up -d
#
# The public hostname that resolves to this machine. Point an A record at the
# machine's public IP, and use a host that is not behind another proxy.
MCP_HOST=understand.example.com

# The username a client sends. Any value works; the password is the secret.
MCP_AUTH_USER=understand

# The hashed password. Generate it with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR-TOKEN'
# Then paste the output here. Never commit .env.
MCP_AUTH_HASH=

# The address on the ACME account. Caddy uses it for expiry notices.
ACME_EMAIL=
